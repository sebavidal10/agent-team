# Usa cualquier modelo LOCAL que ya tengas en Ollama.
# Para un M1 Pro de 16 GB conviene comenzar con un modelo coder de ~7B.
AGENT_MODEL=qwen2.5-coder:7b

# Ollama local. No uses modelos con sufijo "-cloud" si quieres mantener todo local.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
AGENT_TIMEOUT=180

# Límites para no llenar el contexto del modelo.
MAX_FILES=250
MAX_FILE_CHARS=12000
MAX_TOTAL_CHARS=48000
