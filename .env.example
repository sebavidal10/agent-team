# Modelo local de código para Ollama (recomendado: qwen2.5-coder:7b)
AGENT_MODEL=qwen2.5-coder:7b

# Opcional: modelo diferenciado para el Tech Lead / Reviewer (ej. llama3.1:8b o mistral-nemo).
# Si no se define, se usa AGENT_MODEL.
# REVIEWER_MODEL=llama3.1:8b

# URL de Ollama local (sin conexiones externas)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
AGENT_TIMEOUT=180

# Límites de seguridad de contexto
MAX_FILES=250
MAX_FILE_CHARS=12000
MAX_TOTAL_CHARS=48000
